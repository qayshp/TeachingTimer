// Watch target only. The TestFlight scheme embeds it in Apple's empty
// watch-only distribution container (net.qays.TeachingTimer).
// Normal Debug/Release retain the existing teaching installation.
PRODUCT_BUNDLE_IDENTIFIER = net.qays.TeachingTimer.watchkitapp
SKIP_INSTALL = YES
TEACHING_TIMER_DISPLAY_NAME = Teaching Timer Beta
